{
  // Open the extension/ folder as its own VS Code window, then press F5.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.cjs"],
      "preLaunchTask": "${defaultBuildTask}"
    }
  ]
}
