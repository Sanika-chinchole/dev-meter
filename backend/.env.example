# Copy to .env (same folder) and fill in. .env is git-ignored; never commit real values.
# The backend reads it when started from this folder (mvnw spring-boot:run).

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
# Authorized redirect URI must be exactly: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# HS256 signing key for app JWTs, at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
